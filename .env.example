VITE_ERROR_REPORTING_DSN=

# Optional client-side sampling ratio for production error reporting.
VITE_ERROR_REPORTING_SAMPLE_RATE=1

# 正式網域的絕對 origin（不含路徑、不含結尾斜線），供 canonical / og / JSON-LD 注入。
